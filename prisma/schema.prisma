generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String          @unique
  passwordHash   String
  role           Role
  isVerified     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  bondecommandes Bondecommande[]
  cart           Cart?
  client         Client?
  livreur        Livreur?
  ordonnances    Ordonnance[]
  otps           Otp[]
  pharmacies     Pharmacie[]
  paiements      Paiement[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  produitId     String
  quantity      Int
  priceSnapshot Int
  createdAt     DateTime @default(now())
  cart          Cart     @relation(fields: [cartId], references: [id])
  produit       Produit  @relation(fields: [produitId], references: [id])

  @@index([cartId])
  @@index([produitId])
}

model Produit {
  id          String     @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  prix        Int
  createdAt   DateTime   @default(now())
  deletedAt   DateTime?
  pharmacieId String
  categoryId  String

  cartItems   CartItem[]
  commandes   Commande[]
  ordonnanceItems OrdonnanceItem[]   // 👈 AJOUTER
  bondecommandeItems BondecommandeItem[]

  category    Category   @relation(fields: [categoryId], references: [id])
  pharmacie   Pharmacie  @relation(fields: [pharmacieId], references: [id])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  produits  Produit[]
}




model Commune {
  id          String      @id @default(cuid())
  name        String      @unique
  pharmacies  Pharmacie[]
  livreurs  Livreur[]
  clients  Client[]
  createdAt   DateTime    @default(now())
}

model Livreur {
  id        String     @id @default(cuid())
  imageUrl  String?
  communeId String
  commune   Commune @relation(fields: [communeId], references: [id])
  quartier  String?
  userId    String     @unique
  commandes Commande[]
  user      User       @relation(fields: [userId], references: [id])
}

model Client {
  id        String   @id @default(cuid())
  communeId String
  commune   Commune @relation(fields: [communeId], references: [id])
  quartier  String?
  phone     String?
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Pharmacie {
  id             String          @id @default(cuid())
  name           String          @unique
  communeId String
  commune   Commune @relation(fields: [communeId], references: [id])
  quartier       String?
  phone          String?
  logo           String?
  slogan         String?
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  bondecommandes Bondecommande[]
  commandes      Commande[]
  ordonnances    Ordonnance[]
  user           User            @relation(fields: [userId], references: [id])
  produits       Produit[]
}



model Otp {
  id        String   @id @default(cuid())
  code      String
  expiresAt DateTime
  userId    String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Token {
  id        String    @id @default(cuid())
  email     String
  token     String
  expires   DateTime
  type      TokenType
  createdAt DateTime  @default(now())

  @@unique([email, token])
}



model Commande {
  id                    String         @id @default(cuid())
  produitId             String
  livreurId             String?
  status                CommandeStatus @default(EN_ATTENTE)
  quantite              Int
  prixUnitaire          Int
  total                 Int
  adresseLivraison      String?
  telephoneClient       String?
  deliveredAt           DateTime?
  takenAt               DateTime?
  cancelledAt           DateTime?
  instructionsLivraison String?
  createdAt             DateTime       @default(now())
  deletedAt             DateTime?
  pharmacieId           String
  livreur               Livreur?       @relation(fields: [livreurId], references: [id])
  pharmacie             Pharmacie      @relation(fields: [pharmacieId], references: [id])
  produit               Produit        @relation(fields: [produitId], references: [id])
}

enum OrdonnanceStatut {
  ENVOYEE                   //ordonnance envoyée par le client
  DEVIS_RECU                //pharmacie a envoyé le devis
  DEVIS_VALIDEE_PAR_CLIENT  //client accepte le devis
  PAYEE                     //paiement effectué
  PRET                      //pharmacie prépare
  EN_LIVRAISON              //livreur a pris la commande
  LIVREE                    //client reçu
  ANNULEE                   //annulée
}

enum BondecommandeStatut {
  ENVOYEE                   //bondecommande envoyé par le client
  DEVIS_RECU                //pharmacie a envoyé le devis
  DEVIS_VALIDEE_PAR_CLIENT  //client accepte le devis
  PAYEE                     //paiement effectué
  PRET                      //pharmacie prépare
  EN_LIVRAISON              //livreur a pris la commande
  LIVREE                    //client reçu
  ANNULEE                   //annulée
}

enum Role {
  ADMIN
  PHARMACIE
  LIVREUR
  CLIENT
}

enum TokenType {
  REFRESH
  VERIFICATION
  PASSWORD_RESET
  OAUTH
}

enum CommandeStatus {
  EN_ATTENTE
  PUBLIER_AUX_LIVREURS
  EN_COURS
  LIVREE
  ANNULEE_PAR_PHARMACIE
  ANNULEE_PAR_LIVREUR
}
model Bondecommande {
  id               String              @id @default(cuid())
  imageUrl         String
  description      String?
  securite_sociale String
  userId           String
  statut           BondecommandeStatut @default(ENVOYEE)
  prixTotal        Decimal?            @db.Decimal(10, 2)
  pharmacieId      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  items            BondecommandeItem[]
  paiements        Paiement[]

  pharmacie        Pharmacie?          @relation(fields: [pharmacieId], references: [id])
  user             User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([pharmacieId])
  @@index([statut])
}

// BondecommandeItem est reservé pour les bondecommandes envoyés afin de calculer le prix des produits
model BondecommandeItem {
  id            String   @id @default(cuid())
  bondecommandeId  String
  numeroArticle Int?     // 🔥 numéro réel sur le bondecommande
  produitId     String?  // si le produit existe déjà dans la base
  nomProduit    String   // si le produit vient seulement de bondecommande
  quantite      Int
  prixUnitaire  Int
  createdAt     DateTime @default(now())

  bondecommande Bondecommande @relation(fields: [bondecommandeId], references: [id])
  produit    Produit?   @relation(fields: [produitId], references: [id])

  @@index([bondecommandeId])
}
model Ordonnance {
  id          String           @id @default(cuid())
  imageUrl    String
  description String?
  userId      String
  statut      OrdonnanceStatut @default(ENVOYEE)
  prixTotal   Decimal?         @db.Decimal(10, 2)
  pharmacieId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  items       OrdonnanceItem[]
  paiements   Paiement[]

  pharmacie   Pharmacie?       @relation(fields: [pharmacieId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([pharmacieId])
  @@index([statut])
}
// OrdonnanceItem est reservé pour les ordanances envoyés afin de calculer le prix des produits
model OrdonnanceItem {
  id            String   @id @default(cuid())
  ordonnanceId  String
  produitId     String?  // si le produit existe déjà dans la base
  numeroArticle Int?     // 🔥 numéro réel sur l’ordonnance
  nomProduit    String   // si le produit vient seulement de l’ordonnance
  quantite      Int
  prixUnitaire  Int
  createdAt     DateTime @default(now())

  ordonnance Ordonnance @relation(fields: [ordonnanceId], references: [id])
  produit    Produit?   @relation(fields: [produitId], references: [id])

  @@index([ordonnanceId])
}

enum PaiementMethode {
  CARTE
  MTN_MONEY
  MOOV_MONEY
  ORANGE_MONEY
  WAVE
}
enum PaiementProvider {
  CINETPAY
  STRIPE
  PAYDUNYA // ✅ AJOUT

}

model Paiement {
  id               String           @id @default(cuid())
  transactionId    String           @unique //ID de la transaction

  montant          Decimal          @db.Decimal(10, 2)
  montantInitial   Decimal          @db.Decimal(10, 2)//le montant original du paiement au moment où il a été créé, il sécurise le montant qui peut changer (on ne sait jamais)
  fraisService     Decimal          @db.Decimal(10, 2) @default(0)

  devise           String           @default("XOF")//la monnaie utilisée pour le paiement: "XOF" est le  Franc CFA (Côte d'Ivoire 🇨🇮)

  methode          PaiementMethode
  provider         PaiementProvider

  statut           PaiementStatut   @default(EN_ATTENTE)

  referenceExterne String? //l’identifiant que le provider de paiement (PayDunya, CinetPay, Stripe, etc.) te donne
  paymentUrl       String? //pour rediriger Flutter vers paiement
  signature        String? //vérifier que le paiement vient bien du provider (CinetPay, Stripe, etc.) et qu’il n’a pas été falsifié
  message          String? //une information descriptive liée au paiement
 
 receiptUrl       String? // ✅ lien vers le reçu officiel PayDunya (PDF).
 providerHash     String? // ✅ sécurité IPN : signature envoyée par PayDunya pour prouver que a requête vient bien de leurs serveurs et les données n’ont pas été modifiées
 rawData          Json? // ✅ Stocker TOUTE la réponse brute de PayDunya (c'est un json avec toutes les données)

  // 🔥 URL CinetPay
  successUrl       String?//lien si le paiement est un succès
  failureUrl       String?//lien si le paiement est un echec
  notifyUrl        String?//lien de notification envoyé par le provider(cinetpay...)

  // 🔥 Infos client (TRÈS IMPORTANT), car ces valeurs ne chanageront jamais meme si après le client fait une mise à jour de son profil
  customerName     String?
  customerEmail    String?
  customerPhone    String?

  deletedAt        DateTime?  //Le paiement est archivé et non supprimé
  callbackAt       DateTime? //Savoir quand le provider a repondu
  expiresAt        DateTime? // La date et l’heure où le paiement expire


  // 🔥 relations
  userId           String
  user             User             @relation(fields: [userId], references: [id])

  ordonnanceId     String?
  ordonnance       Ordonnance?      @relation(fields: [ordonnanceId], references: [id])

  bondecommandeId     String?
  bondecommande       Bondecommande?      @relation(fields: [bondecommandeId], references: [id])
  // 🔥 système générique
  type             PaiementType
  resourceId       String //ID de la ressource(id de ordonnance ou bondecommande...) que tu es en train de payer

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])//Idéal pour les recherches par userId
  @@index([resourceId])//Idéal pour les recherches par resourceId
  @@index([transactionId])//Idéal pour les recherches par transactionId
}
enum PaiementStatut {
  EN_ATTENTE     // paiement initié, en attente de confirmation
  EN_COURS       // utilisateur en train de payer (optionnel mais utile)
  SUCCES         // paiement validé
  ECHEC          // paiement échoué
  ANNULE         // annulé par l'utilisateur
  EXPIRE         // session de paiement expirée
  REMBOURSE      // remboursement effectué (optionnel pour plus tard)
}
enum PaiementType {
  ORDONNANCE
  BON_COMMANDE
  LIVRAISON
}