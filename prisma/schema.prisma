generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String          @unique
  passwordHash   String
  role           Role
  isVerified     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  bondecommandes Bondecommande[]
  cart           Cart?
  client         Client?
  livreur        Livreur?
  ordonnances    Ordonnance[]
  otps           Otp[]
  pharmacies     Pharmacie[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  produitId     String
  quantity      Int
  priceSnapshot Int
  createdAt     DateTime @default(now())
  cart          Cart     @relation(fields: [cartId], references: [id])
  produit       Produit  @relation(fields: [produitId], references: [id])

  @@index([cartId])
  @@index([produitId])
}

model Produit {
  id          String     @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  prix        Int
  createdAt   DateTime   @default(now())
  deletedAt   DateTime?
  pharmacieId String
  categoryId  String
  cartItems   CartItem[]
  commandes   Commande[]
  ordonnanceItems OrdonnanceItem[]   // 👈 AJOUTER
  category    Category   @relation(fields: [categoryId], references: [id])
  pharmacie   Pharmacie  @relation(fields: [pharmacieId], references: [id])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  produits  Produit[]
}

model Ordonnance {
  id          String           @id @default(cuid())
  imageUrl    String
  description String?
  userId      String
  statut      OrdonnanceStatut @default(ENVOYEE)
  prixTotal   Decimal?         @db.Decimal(10, 2)
  pharmacieId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  items       OrdonnanceItem[]

  pharmacie   Pharmacie?       @relation(fields: [pharmacieId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([pharmacieId])
  @@index([statut])
}
// OrdonnanceItem est reservé pour les ordanances envoyés afin de calculer le prix des produits
model OrdonnanceItem {
  id            String   @id @default(cuid())
  ordonnanceId  String
  produitId     String?  // si le produit existe déjà dans la base
  nomProduit    String   // si le produit vient seulement de l’ordonnance
  quantite      Int
  prixUnitaire  Int
  createdAt     DateTime @default(now())

  ordonnance Ordonnance @relation(fields: [ordonnanceId], references: [id])
  produit    Produit?   @relation(fields: [produitId], references: [id])

  @@index([ordonnanceId])
}
model Commune {
  id          String      @id @default(cuid())
  name        String      @unique
  pharmacies  Pharmacie[]
  livreurs  Livreur[]
  clients  Client[]
  createdAt   DateTime    @default(now())
}

model Livreur {
  id        String     @id @default(cuid())
  imageUrl  String?
  communeId String
  commune   Commune @relation(fields: [communeId], references: [id])
  quartier  String?
  userId    String     @unique
  commandes Commande[]
  user      User       @relation(fields: [userId], references: [id])
}

model Client {
  id        String   @id @default(cuid())
  communeId String
  commune   Commune @relation(fields: [communeId], references: [id])
  quartier  String?
  phone     String?
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Pharmacie {
  id             String          @id @default(cuid())
  name           String          @unique
  communeId String
  commune   Commune @relation(fields: [communeId], references: [id])
  quartier       String?
  phone          String?
  logo           String?
  slogan         String?
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  bondecommandes Bondecommande[]
  commandes      Commande[]
  ordonnances    Ordonnance[]
  user           User            @relation(fields: [userId], references: [id])
  produits       Produit[]
}

model Bondecommande {
  id               String              @id @default(cuid())
  imageUrl         String
  description      String?
  securite_sociale String
  userId           String
  statut           BondecommandeStatut @default(ENVOYEE)
  prixTotal        Decimal?            @db.Decimal(10, 2)
  pharmacieId      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  pharmacie        Pharmacie?          @relation(fields: [pharmacieId], references: [id])
  user             User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([pharmacieId])
  @@index([statut])
}

model Otp {
  id        String   @id @default(cuid())
  code      String
  expiresAt DateTime
  userId    String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Token {
  id        String    @id @default(cuid())
  email     String
  token     String
  expires   DateTime
  type      TokenType
  createdAt DateTime  @default(now())

  @@unique([email, token])
}



model Commande {
  id                    String         @id @default(cuid())
  produitId             String
  livreurId             String?
  status                CommandeStatus @default(EN_ATTENTE)
  quantite              Int
  prixUnitaire          Int
  total                 Int
  adresseLivraison      String?
  telephoneClient       String?
  deliveredAt           DateTime?
  takenAt               DateTime?
  cancelledAt           DateTime?
  instructionsLivraison String?
  createdAt             DateTime       @default(now())
  deletedAt             DateTime?
  pharmacieId           String
  livreur               Livreur?       @relation(fields: [livreurId], references: [id])
  pharmacie             Pharmacie      @relation(fields: [pharmacieId], references: [id])
  produit               Produit        @relation(fields: [produitId], references: [id])
}

enum OrdonnanceStatut {
  ENVOYEE
  DEVIS_RECU
  DEVIS_VALIDEE_PAR_CLIENT
  PRET
  LIVREE
  ANNULEE
}

enum BondecommandeStatut {
  ENVOYEE
  DEVIS_RECU
  PRET
  LIVREE
  ANNULEE
}

enum Role {
  ADMIN
  PHARMACIE
  LIVREUR
  CLIENT
}

enum TokenType {
  REFRESH
  VERIFICATION
  PASSWORD_RESET
  OAUTH
}

enum CommandeStatus {
  EN_ATTENTE
  PUBLIER_AUX_LIVREURS
  EN_COURS
  LIVREE
  ANNULEE_PAR_PHARMACIE
  ANNULEE_PAR_LIVREUR
}
